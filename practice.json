[
 {"slug":"two-sum","function":"twoSum","params":["nums","target"],"topics":["Array","Hash Table"],"description":"Given an integer array nums and an integer target, return the indices of two distinct elements whose sum is target. Exactly one valid pair exists. Return the smaller index first for this local practice suite.","tests":[{"args":[[2,7,11,15],9],"expected":[0,1]},{"args":[[3,2,4],6],"expected":[1,2]},{"args":[[3,3],6],"expected":[0,1]},{"args":[[-3,4,3,90],0],"expected":[0,2]},{"args":[[0,4,3,0],0],"expected":[0,3]}]},
 {"slug":"longest-substring-without-repeating-characters","function":"lengthOfLongestSubstring","params":["s"],"topics":["String","Sliding Window"],"description":"Return the length of the longest contiguous substring of s that contains no repeated characters.","tests":[{"args":["abcabcbb"],"expected":3},{"args":["bbbbb"],"expected":1},{"args":["pwwkew"],"expected":3},{"args":[""],"expected":0},{"args":["abba"],"expected":2}]},
 {"slug":"median-of-two-sorted-arrays","function":"findMedianSortedArrays","params":["nums1","nums2"],"topics":["Array","Binary Search"],"description":"Given two sorted arrays whose combined length is positive, return the median of their combined values.","tests":[{"args":[[1,3],[2]],"expected":2},{"args":[[1,2],[3,4]],"expected":2.5},{"args":[[],[1]],"expected":1},{"args":[[0,0],[0,0]],"expected":0}]},
 {"slug":"palindrome-number","function":"isPalindrome","params":["x"],"topics":["Math"],"description":"Return whether the integer x reads identically forwards and backwards in decimal. Negative integers are not palindromes.","tests":[{"args":[121],"expected":true},{"args":[-121],"expected":false},{"args":[10],"expected":false},{"args":[0],"expected":true},{"args":[12321],"expected":true}]},
