 {"slug":"search-insert-position","function":"searchInsert","params":["nums","target"],"topics":["Array","Binary Search"],"description":"For a sorted array of distinct integers, return the index of target or the insertion index that preserves the sorted order.","tests":[{"args":[[1,3,5,6],5],"expected":2},{"args":[[1,3,5,6],2],"expected":1},{"args":[[1,3,5,6],7],"expected":4},{"args":[[1],0],"expected":0}]},
