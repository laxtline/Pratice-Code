 {"slug":"longest-common-prefix","function":"longestCommonPrefix","params":["strs"],"topics":["String"],"description":"Return the longest prefix shared by every string in strs, or an empty string when no common prefix exists.","tests":[{"args":[["flower","flow","flight"]],"expected":"fl"},{"args":[["dog","racecar","car"]],"expected":""},{"args":[[""]],"expected":""},{"args":[["a"]],"expected":"a"}]},
