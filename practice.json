 {"slug":"length-of-last-word","function":"lengthOfLastWord","params":["s"],"topics":["String"],"description":"Return the length of the last word in s. A word is a sequence of non-space characters; ignore trailing spaces.","tests":[{"args":["Hello World"],"expected":5},{"args":["   fly me   to   the moon  "],"expected":4},{"args":["a"],"expected":1},{"args":["luffy is still joyboy"],"expected":6}]},
