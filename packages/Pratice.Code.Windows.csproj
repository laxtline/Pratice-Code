<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>Pratice.Code.Windows</PackageId>
    <Version>1.2.0</Version>
    <Authors>laxtline</Authors>
    <Description>Pratice Code offline Windows installer with bundled Python, WebView2 and the complete study collection.</Description>
    <PackageProjectUrl>https://github.com/laxtline/Pratice-Code</PackageProjectUrl>
    <RepositoryUrl>https://github.com/laxtline/Pratice-Code.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>coding-practice;windows;offline;education</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="assets/Pratice-Code-Setup.exe" Pack="true" PackagePath="tools/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
