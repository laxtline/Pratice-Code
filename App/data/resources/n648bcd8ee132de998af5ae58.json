       ${ data.badges }\n                </text>\n            </g>\n        </g>\n\n    <!-- Contributions -->\n        <g transform=\"translate(0, 180)\">\n            <g class=\"stagger\" style=\"animation-delay: 1050ms\" transform=\"translate(15, 0)\">\n                <svg data-testid=\"icon\" class=\"icon\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\">\n                    <path fill-rule=\"evenodd\" d=\"M2 2.5A2.5 2.5 0 014.5 0h8.75a.75.75 0 01.75.75v12.5a.75.75 0 01-.75.75h-2.5a.75.75 0 110-1.5h1.75v-2h-8a1 1 0 00-.714 1.7.75.75 0 01-1.072 1.05A2.495 2.495 0 012 11.5v-9zm10.5-1V9h-8c-.356 0-.694.074-1 .208V2.5a1 1 0 011-1h8zM5 12.25v3.25a.25.25 0 00.4.2l1.45-1.087a.25.25 0 01.3 0L8.6 15.7a.25.25 0 00.4-.2v-3.25a.25.25 0 00-.25-.25h-3.5a.25.25 0 00-.25.25z\"/>\n                </svg>\n                <text class=\"statText bold\" x=\"40\" y=\"12.5\">\n                    Contributions Score:\n                </text>\n                <text\n                    class=\"stat bold\"\n                    x=\"260\"\n                    y=\"12.5\"\n                    data-testid=\"contribs\"\n                >\n                    ${ data.contributions}\n                </text>\n            </g>\n        </g>\n    </g>\n</svg>`;\n}","source":"New folder (2)/greenj-readme-statistics-main/greenj-readme-statistics-main/src/leetcode/modals/stats-card.ts"}