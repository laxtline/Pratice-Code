     <text class=\"statText bold\" x=\"40\" y=\"12.5\">\n                    Reputation:\n                </text>\n                <text\n                    class=\"stat bold\"\n                    x=\"260\"\n                    y=\"12.5\"\n                    data-testid=\"commits\"\n                >\n                    ${data.reputation}\n                </text>\n            </g>\n        </g>\n\n    <!-- Stars -->\n        <g transform=\"translate(0, 120)\">\n            <g class=\"stagger\" style=\"animation-delay: 750ms\" transform=\"translate(15, 0)\">\n                <svg data-testid=\"icon\" class=\"icon\" version=\"1.1\" id=\"Icons\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" viewBox=\"0 0 16 16\" xml:space=\"preserve\" width=\"16\" height=\"16\">\n                    <g>\n                        <path class=\"st0\" d=\"M8.95 4.95c-2.3 0.45 -3 1.15 -3.45 3.45 -0.45 -2.3 -1.15 -3 -3.45 -3.45C4.35 4.5 5.05 3.8 5.5 1.5c0.45 2.3 1.15 3 3.45 3.45z\"/>\n                    </g>\n                    <g>\n                        <path class=\"st0\" d=\"M10.9 12.5c-1.6 0.3 -2.05 0.8 -2.4 2.4 -0.3 -1.6 -0.8 -2.05 -2.4 -2.4 1.6 -0.3 2.05 -0.8 2.4 -2.4 0.3 1.6 0.8 2.1 2.4 2.4z\"/>\n                    </g>\n                    <g>\n                        <path class=\"st0\" d=\"M14.5 7.5c-1.3 0.25 -1.7 0.65 -1.95 1.95 -0.25 -1.3 -0.65 -1.7 -1.95 -1.95 1.3 -0.25 1.7 -0.65 1.95 -1.95 0.25 1.3 0.65 1.7 1.95 1.95z\"/>\n                    </g>\n                    <path class=\"st0\" x1=\"5\" y1=\"23\" x2=\"5\" y2=\"23\" d=\"M2.5 11.5L2.5 11.5\"/>\n                    <path class=\"st0\" x1=\"28\" y1=\"6\" x2=\"28\" y2=\"6\" d=\"M14 3L14 3\"/>\n                </svg>\n                <text class=\"statText bold\" x=\"40\" y=\"12.5\">\n                    Total Stars:\n                </text>\n                <text\n                    class=\"stat bold\"\n                    x=\"260\"\n                    y=\"12.5\"\n                    data-testid=\"prs\"\n                >\n                    ${ data.stars }\n                </text>\n            </g>\n        </g>\n\n    <!-- Badges -->\n        <g transform=\"translate(0, 150)\">\n            <g class=\"stagger\" style=\"animation-delay: 1050ms\" transform=\"translate(15, 0)\">\n                <svg data-testid=\"icon\" class=\"icon\" version=\"1.1\" id=\"Layer_1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\" viewBox=\"0 0 16 16\" style=\"enable-background:new 0 0 511.999 511.999;\" xml:space=\"preserve\" width=\"16\" height=\"16\">\n                    <path d=\"m14.987 12.533 0.968 -1.452a0.267 0.267 0 0 0 0.013 -0.274 0.267 0.267 0 0 0 -0.235 -0.141h-1.6V9.6a0.266 0.266 0 0 0 -0.267 -0.267H13.6V2.4a0.266 0.266 0 0 0 -0.267 -0.267h-0.8V0.8a0.266 0.266 0 0 0 -0.267 -0.267H3.733a0.266 0.266 0 0 0 -0.267 0.267v1.333h-0.8A0.266 0.266 0 0 0 2.4 2.4v6.933h-0.267a0.266 0.266 0 0 0 -0.267 0.267v1.067h-1.6a0.267 0.267 0 0 0 -0.235 0.141 0.267 0.267 0 0 0 0.013 0.274l0.968 1.452L0.045 13.985a0.267 0.267 0 0 0 -0.013 0.274 0.267 0.267 0 0 0 0.235 0.141h2.4a0.266 0.266 0 0 0 0.267 -0.267v-1.067h1.569l3.345 2.351c0.046 0.032 0.1 0.049 0.153 0.049s0.107 -0.016 0.153 -0.049l3.345 -2.351h1.569v1.067a0.266 0.266 0 0 0 0.267 0.267h2.4a0.267 0.267 0 0 0 0.235 -0.141 0.267 0.267 0 0 0 -0.013 -0.274l-0.968 -1.452zM3.467 3.467a0.266 0.266 0 0 1 0.267 -0.267h0.8V1.867a0.266 0.266 0 0 1 0.267 -0.267h6.4a0.266 0.266 0 0 1 0.267 0.267V3.2h0.8a0.266 0.266 0 0 1 0.267 0.267v5.867H12v-5.6h-0.8a0.266 0.266 0 0 1 -0.267 -0.267V2.133H5.067v1.333a0.266 0.266 0 0 1 -0.267 0.267H4v5.6h-0.533V3.467zm2.667 2.4C6.133 4.838 6.971 4 8 4c1.029 0 1.867 0.838 1.867 1.867 0 0.654 -0.339 1.229 -0.849 1.563 0.739 0.348 1.273 1.059 1.367 1.904h-0.537c-0.13 -0.903 -0.909 -1.6 -1.848 -1.6s-1.718 0.697 -1.848 1.6h-0.537c0.094 -0.845 0.628 -1.556 1.367 -1.904 -0.51 -0.334 -0.849 -0.909 -0.849 -1.563zm-3.733 8H0.765l0.79 -1.185a0